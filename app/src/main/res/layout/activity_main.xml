<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 权限统一收进右上角齿轮里的设置页，主页只在不正常时提示一行 -->
        <TextView
            android:id="@+id/tvPermWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#22FF9800"
            android:padding="10dp"
            android:textColor="#FF8A4B00"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvDiag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <TextView
            style="@style/SectionTitle"
            android:text="试一试" />

        <EditText
            android:id="@+id/inputText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="粘贴一条消息，例如：明天下午3点在正心楼开组会"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnParse"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="识别并创建" />

            <Button
                android:id="@+id/btnAdd"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="手动添加" />
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:text="提醒" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnActive"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="待处理" />

            <Button
                android:id="@+id/btnArchived"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="归档" />
        </LinearLayout>

        <TextView
            android:id="@+id/emptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:text="还没有提醒。收到含时间的通知后会自动出现在这里。" />

        <LinearLayout
            android:id="@+id/reminderContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@style/SectionTitle"
            android:text="未记录的通知" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:text="这些通知被过滤了或没识别出时间。可以在这里补录、监听来源 App、或屏蔽该会话。"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/emptyDropped"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="6dp"
            android:text="没有未记录的通知。" />

        <LinearLayout
            android:id="@+id/droppedContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnClearDropped"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="清空未记录列表" />

        <TextView
            style="@style/SectionTitle"
            android:text="最近处理的通知" />

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
