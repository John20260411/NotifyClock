<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="22dp"
    android:paddingEnd="24dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/dlgTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/app_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dlgWhen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/brand_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dlgSource"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/app_text_muted"
        android:textSize="13sp" />

    <ScrollView
        android:id="@+id/dlgBodyScroll"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="14dp">

        <TextView
            android:id="@+id/dlgBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/app_text"
            android:textIsSelectable="true"
            android:textSize="15sp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/dlgActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dlgBtn1"
            style="@style/ItemAction"
            android:text="修改" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dlgBtn2"
            style="@style/ItemAction"
            android:text="打开原通知" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dlgBtn3"
            style="@style/ItemAction"
            android:text="彻底关闭" />
    </LinearLayout>
</LinearLayout>
