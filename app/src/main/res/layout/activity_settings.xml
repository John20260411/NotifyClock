<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_permissions" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/permission_hint" />

        <LinearLayout
            android:id="@+id/permContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnTestListener"
            style="@style/ActionButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:text="@string/btn_test_listener" />

        <TextView
            android:id="@+id/tvDiag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnAttempts"
            style="@style/ActionButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:text="@string/btn_attempts" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_language" />

        <RadioGroup
            android:id="@+id/rgLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rbLangSystem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/language_system" />

            <RadioButton
                android:id="@+id/rbLangZh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/language_zh" />

            <RadioButton
                android:id="@+id/rbLangEn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/language_en" />
        </RadioGroup>

        <TextView
            style="@style/FieldLabel"
            android:text="@string/language_hint" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_alarm" />

        <TextView style="@style/FieldLabel" android:text="@string/offsets_label" />

        <EditText
            android:id="@+id/etOffsets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="60,10,0"
            android:inputType="text" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swSound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/switch_sound" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swVibrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/switch_vibrate" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/app_surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/app_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ringtone_title"
                    android:textColor="@color/app_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/app_text_muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPickRingtone"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="@string/change_ringtone"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        app:cornerRadius="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPreview"
                        style="@style/ActionButton"
                        android:layout_width="88dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="10dp"
                        android:text="@string/preview"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        app:cornerRadius="14dp"
                        app:strokeColor="@color/app_outline" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/FieldLabel" android:text="@string/volume_follow" />

        <RadioGroup
            android:id="@+id/rgVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbAlarmVolume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/volume_alarm" />

            <RadioButton
                android:id="@+id/rbMediaVolume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/volume_media" />
        </RadioGroup>

        <TextView style="@style/FieldLabel" android:text="@string/ring_minutes_label" />

        <EditText
            android:id="@+id/etRingMinutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <TextView style="@style/FieldLabel" android:text="@string/snooze_label" />

        <EditText
            android:id="@+id/etSnooze"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="5,10,30,60"
            android:inputType="text" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_quiet" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swQuiet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/switch_quiet" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnQuietStart"
                style="@style/ActionButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnQuietEnd"
                style="@style/ActionButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            style="@style/FieldLabel"
            android:text="@string/quiet_hint" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swQuietKeep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/switch_quiet_keep" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_parse" />

        <RadioGroup
            android:id="@+id/rgMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rbHybrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_hybrid" />

            <RadioButton
                android:id="@+id/rbLlm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_llm" />

            <RadioButton
                android:id="@+id/rbRule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_rule" />
        </RadioGroup>

        <TextView
            style="@style/FieldLabel"
            android:text="@string/llm_hint" />

        <EditText
            android:id="@+id/etUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://api.deepseek.com"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/etKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_api_key"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/etModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_model"
            android:inputType="text" />

        <Button
            android:id="@+id/btnTestLlm"
            style="@style/ActionButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/btn_test_llm" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_blacklist" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/blacklist_hint" />

        <Spinner
            android:id="@+id/spBlackType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/etBlackValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_black_value"
            android:inputType="text" />

        <Button
            android:id="@+id/btnAddBlack"
            style="@style/ActionButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/btn_add_black" />

        <TextView
            android:id="@+id/blackStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:text="@string/blacklist_empty"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/blackContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_apps" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swMonitorAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/switch_monitor_all" />

        <TextView
            android:id="@+id/appsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/apps_loading" />

        <LinearLayout
            android:id="@+id/appsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
